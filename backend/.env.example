# Muse 后端环境变量示例。复制为 .env 后按需修改；.env 不入库（见根 .gitignore）。

# 应用
APP_NAME=Muse
# 本地开发用 true：允许默认占位 JWT_SECRET 开箱即用。生产部署改 false 时务必换强随机密钥（否则 fail-fast 拒启动）。
DEBUG=true

# 数据库：SQLAlchemy 2.0 async + psycopg3，DSN 必须为 postgresql+psycopg://
# 与 docker-compose.yml 的 postgres 服务对应（用户/密码/库均为 muse）
DATABASE_URL=postgresql+psycopg://muse:muse@localhost:5432/muse
# SQL echo 独立于 DEBUG：打开会打印绑定参数（含 token_hash/密码哈希），仅本地排障临时开
DB_ECHO=false

# Redis：ARQ broker + SSE/缓存 + 登录失败限流
REDIS_URL=redis://localhost:6379/0

# JWT 签名密钥：生产（DEBUG=false）务必替换为强随机值，否则启动即失败（fail-fast）
JWT_SECRET=dev-only-change-me
# 双 token 有效期（秒）：access 短期无状态（默认 15 分钟）、refresh 长效可撤销（默认 30 天）
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=2592000

# BYOK 主密钥（Story 1.7）：应用层 AES-256-GCM 加密用户 API Key 的主密钥。
# 生产（DEBUG=false）务必换成 base64 编码的 32 字节强随机串，否则 fail-fast 拒启动。生成方式：
#   python -c "import base64,os; print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
BYOK_MASTER_KEY=dev-only-byok-key-change-me

# 托管免费额度护栏阈值（Story 1.8）：托管路径累计 tokens 触顶即拦（BYOK 用户不占额度、不拦截）。
# 单位为 tokens（SUM(total_tokens) vs 此阈值），非「章」——记账一次调用一行、一章 5–10 次调用，
# 按调用数当章数会 5–10 倍虚高触顶，故以 tokens 计量与记账粒度对齐。
# 占位值，盲测出单章真实 token 成本后定档调整。业务配置非安全密钥，无 fail-fast。
FREE_QUOTA_TOKENS=200000
